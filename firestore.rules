rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && roleOf(request.auth.uid) == 'SUPER_ADMIN';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'USER';
      // Only SUPER_ADMIN may assign SUPER_ADMIN or change a SUPER_ADMIN role.
      allow update: if isSuperAdmin()
        || (isAdmin()
          && resource.data.role != 'SUPER_ADMIN'
          && request.resource.data.role in ['USER', 'ADMIN'])
        || (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();

      match /drafts/{draftId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if resource.data.visibility == 'PUBLIC' || isAdmin()
        || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.creatorId == request.auth.uid);
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /savedTickets/{savedTicketId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /followers/{followId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // SUPER_ADMIN has full database control, including future system collections.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
