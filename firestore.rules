rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function roleOf(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.role; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && roleOf(request.auth.uid) in ['ADMIN','SUPER_ADMIN']; }
    function isSuperAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && roleOf(request.auth.uid) == 'SUPER_ADMIN'; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'USER';
      allow update: if isSuperAdmin()
        || (isAdmin() && resource.data.role != 'SUPER_ADMIN' && request.resource.data.role in ['USER','ADMIN'])
        || (isOwner(userId) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
      match /drafts/{draftId} { allow read, create, update, delete: if isOwner(userId) || isAdmin(); }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sports/{id} { allow read: if true; allow write: if isAdmin(); }
    match /leagues/{id} { allow read: if true; allow write: if isAdmin(); }
    match /teams/{id} { allow read: if true; allow write: if isAdmin(); }
    match /results/{id} { allow read: if true; allow write: if isAdmin(); }
    match /api_logs/{id} { allow read: if isAdmin(); allow write: if false; }

    match /tickets/{ticketId} {
      allow read: if resource.data.visibility == 'PUBLIC' || isAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.totalOdds > 0;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.creatorId == request.auth.uid
          && resource.data.status == 'PENDING'
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.status == resource.data.status
          && request.resource.data.totalOdds == resource.data.totalOdds);
      allow delete: if isAdmin() || (signedIn() && resource.data.creatorId == request.auth.uid && resource.data.status == 'PENDING');
      match /selections/{selectionId} {
        allow read: if get(/databases/$(database)/documents/tickets/$(ticketId)).data.visibility == 'PUBLIC'
          || isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/tickets/$(ticketId)).data.creatorId == request.auth.uid);
        allow create: if signedIn()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.creatorId == request.auth.uid
          && request.resource.data.status == 'PENDING'
          && request.resource.data.kickoffAt > request.time;
        allow update, delete: if isAdmin() || (
          signedIn()
          && get(/databases/$(database)/documents/tickets/$(ticketId)).data.creatorId == request.auth.uid
          && request.resource.data.status == 'PENDING'
          && resource.data.kickoffAt > request.time
          && request.resource.data.matchId == resource.data.matchId
          && request.resource.data.odds == resource.data.odds
        );
      }
    }

    match /likes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /savedTickets/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    match /followers/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid && request.resource.data.followingId != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
    }
    match /payments/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if isAdmin(); }
    match /subscriptions/{id} { allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid); allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if isSuperAdmin(); }
  }
}